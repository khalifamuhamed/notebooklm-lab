# Names only — copy to a LOCAL file and fill in. Never commit real values.
# On your PC the simplest way is:  python -m notebooklm_lab config init
# (creates <data folder>\notebooklm-lab.env). Real environment variables override the file.

# --- Telegram (feature: send the morning podcast + summary) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = `morning` sends to Telegram automatically after each run (opt-in; same as `morning --telegram`)
NOTEBOOKLM_LAB_TELEGRAM_AUTO=

# --- Obsidian (feature: save the summary + podcast into your vault as plain files) ---
# Full path of an EXISTING vault folder, e.g. C:\Users\you\Documents\MyVault
OBSIDIAN_VAULT=
# Sub-folder inside the vault (default: NotebookLM)
OBSIDIAN_SUBFOLDER=
# 1 = `morning` saves to Obsidian automatically after each run (opt-in; same as `morning --obsidian`)
NOTEBOOKLM_LAB_OBSIDIAN_AUTO=

# --- YouTube channels (feature: follow channels; `morning` checks them first) ---
# Leave empty = ON when you follow at least one channel. Set 0 to stop `morning` from checking channels automatically.
NOTEBOOKLM_LAB_CHANNELS_AUTO=
